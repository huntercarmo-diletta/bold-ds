+      let total = 0, abre = 0; const mortos = [];
+      for (let x = Math.ceil(r.left); x < r.right; x++) for (let y = Math.ceil(r.top); y < r.bottom; y++) {
+        const px = x + 0.5, py = y + 0.5, e = sr.elementFromPoint(px, py);
+        total++;
+        if (e?.tagName === 'SELECT') { abre++; continue; }
+        const naBorda = px - r.left < 2 || r.right - px < 2 || py - r.top < 2 || r.bottom - py < 2;
+        if (!naBorda && !naQuina(px, py)) mortos.push(`${(px - r.left).toFixed(1)},${(py - r.top).toFixed(1)}:${nome(e)}`);
+      }
+      const pontos = {
+        seta: [s.left + s.width / 2, s.top + s.height / 2],
+        recuoEsquerdo: [r.left + 3, r.top + r.height / 2],
+        recuoAcima: [r.left + r.width / 3, r.top + 3],
+        dentro2pxEsquerda: [r.left + 2.5, r.top + r.height / 2],
+        dentro2pxDireita: [r.right - 2.5, r.top + r.height / 2],
+        dentro2pxTopo: [r.left + r.width / 2, r.top + 2.5],
+        dentro2pxBase: [r.left + r.width / 2, r.bottom - 2.5],
+      };
+      const quem = Object.fromEntries(Object.entries(pontos).map(([k, [x, y]]) => [k, nome(sr.elementFromPoint(x, y))]));
+      const cursor = (raiz, x, y) => { const e = raiz.elementFromPoint(x, y); return e ? getComputedStyle(e).cursor : 'nada'; };
+      const off = document.querySelector(`[data-k="off-${m}-${p}"]`).shadowRoot;
+      const ro = off.querySelector('.caixa').getBoundingClientRect(), so = off.querySelector('.seta').getBoundingClientRect();
+      out[`${m}/${p}`] = {
+        largura: host.getBoundingClientRect().width,
+        abre: +(100 * abre / total).toFixed(1), mortos: mortos.slice(0, 5), nMortos: mortos.length, quem,
+        cursorLigado: [cursor(sr, ...pontos.seta), cursor(sr, ...pontos.recuoEsquerdo)],
+        cursorDesligado: [cursor(off, so.left + so.width / 2, so.top + so.height / 2), cursor(off, ro.left + 3, ro.top + ro.height / 2)],
+      };
+    }
+    document.getElementById('saida').textContent = 'MEDIDA=' + JSON.stringify(out);
+  }
+</script></body></html>
+"""
+
+DIFERENCA = r"""<!doctype html><meta charset="utf-8"><pre id="saida"></pre>
+<script type="module">
+  const carrega = (src) => new Promise((ok, erro) => { const i = new Image(); i.onload = () => ok(i); i.onerror = erro; i.src = src; });
+  const px = (img) => { const c = document.createElement('canvas'); c.width = img.width; c.height = img.height;
+    const g = c.getContext('2d'); g.drawImage(img, 0, 0); return g.getImageData(0, 0, img.width, img.height).data; };
+  const out = {};
+  for (const par of new URLSearchParams(location.search).getAll('par')) {
+    const [a, b] = par.split(',');
+    const [ia, ib] = await Promise.all([carrega(a), carrega(b)]);
+    if (ia.width !== ib.width || ia.height !== ib.height) { out[par] = -1; continue; }
+    const da = px(ia), db = px(ib); let n = 0;
+    for (let i = 0; i < da.length; i += 4) if (da[i] !== db[i] || da[i + 1] !== db[i + 1] || da[i + 2] !== db[i + 2]) n++;
+    out[par] = n;
+  }
+  document.getElementById('saida').textContent = 'DIFERENCA=' + JSON.stringify(out);
+</script>
+"""
+
+
+def acha_o_chromium() -> str | None:
+    for c in [os.environ.get("CHROME"), *LUGARES]:
+        if not c:
+            continue
+        if Path(c).is_file():
+            return c
+        achado = shutil.which(c)
+        if achado:
+            return achado
+    return None
+
+
+class Navegador:
+    def __init__(self, exe: str, pasta: Path, porta: int):
+        self.exe, self.pasta, self.porta = exe, pasta, porta
+        self.perfil = pasta / "_perfil"
+
+    def _roda(self, *args: str) -> str:
+        r = subprocess.run([self.exe, "--headless=new", "--disable-gpu", "--no-first-run", "--hide-scrollbars",
+                            "--force-device-scale-factor=1", f"--user-data-dir={self.perfil}",
+                            "--window-size=1400,1000", "--virtual-time-budget=5000", *args],
+                           capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=120)
+        return r.stdout
+
+    def le(self, pagina: str, marca: str) -> dict:
+        dom = self._roda("--dump-dom", f"http://127.0.0.1:{self.porta}/{pagina}")
+        m = re.search(rf"{marca}=(\{{.*?\}})</pre>", dom, flags=re.S)
+        if not m:
+            raise RuntimeError(f"a página {pagina} não devolveu {marca} — o módulo carregou?")
+        return json.loads(m.group(1).replace("&amp;", "&").replace("&lt;", "<").replace("&gt;", ">"))
+
+    def captura(self, nome: str, consulta: str) -> str:
+        self._roda(f"--screenshot={self.pasta / nome}", f"http://127.0.0.1:{self.porta}/medida.html?so=captura&{consulta}")
+        return nome
+
+
+def serve(pasta: Path) -> tuple[http.server.ThreadingHTTPServer, int]:
+    class Quieto(http.server.SimpleHTTPRequestHandler):
+        def log_message(self, *_):
+            pass
+    Quieto.extensions_map = {**Quieto.extensions_map, ".js": "text/javascript"}
+    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), functools.partial(Quieto, directory=str(pasta)))
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    return srv, srv.server_address[1]
+
+
+def confere_a_area(medida: dict) -> list[str]:
+    falhas = []
+    for k, x in medida.items():
+        for ponto, quem in x["quem"].items():
+            if quem != "select":
+                falhas.append(f"{k}: {ponto} cai em {quem}, e não no select")
+        if x["nMortos"]:
+            falhas.append(f"{k}: {x['nMortos']} pontos mortos dentro da caixa, como {x['mortos']}")
+        if any(c != "pointer" for c in x["cursorLigado"]):
+            falhas.append(f"{k}: cursor {x['cursorLigado']} na seta e no recuo, e não pointer")
+        if any(c != "default" for c in x["cursorDesligado"]):
+            falhas.append(f"{k}: desabilitado com cursor {x['cursorDesligado']}, e não default")
+    return falhas
+
+
+def main() -> int:
+    contra = sys.argv[sys.argv.index("--contra") + 1] if "--contra" in sys.argv else None
+    exe = acha_o_chromium()
+    if not exe:
+        print("· pulado: nenhum Chromium achado (aponte `CHROME`). A catraca de papel continua no `npm test`.")
+        return 0
+
+    with tempfile.TemporaryDirectory() as tmp:
+        pasta = Path(tmp)
+        shutil.copytree(SRC, pasta / "atual")
+        shutil.copytree(TOKENS, pasta / "tokens")
+        (pasta / "medida.html").write_text(PAGINA, encoding="utf-8")
+        (pasta / "diferenca.html").write_text(DIFERENCA, encoding="utf-8")
+        if contra:
+            (pasta / "antes").mkdir()
+            arq = subprocess.run(["git", "archive", contra, "packages/diletta_design_system_web/src"],
+                                 cwd=RAIZ, capture_output=True, check=True).stdout
+            subprocess.run(["tar", "-x", "-C", str(pasta / "antes"), "--strip-components=3"], input=arq, check=True)
+
+        srv, porta = serve(pasta)
+        nav = Navegador(exe, pasta, porta)
+        try:
+            agora = nav.le("medida.html?v=atual", "MEDIDA")
+            falhas = confere_a_area(agora)
+            print(f"camada 1 · a área de clique ({Path(exe).name}):")
+            for k, x in agora.items():
+                print(f"  {k:<14} abre {x['abre']:>5}% da caixa · largura {x['largura']:.0f}px")
+
+            if contra:
+                antes = nav.le("medida.html?v=antes", "MEDIDA")
+                print(f"camada 2 · a vista fechada contra {contra}:")
+                for k in agora:
+                    if abs(agora[k]["largura"] - antes[k]["largura"]) > 0.01:
+                        falhas.append(f"{k}: largura intrínseca {antes[k]['largura']} → {agora[k]['largura']}")
+                casos = [(f"{t}{'-foco' if f else ''}", f"tema={t}" + (f"&foco={f}" if f else ""))
+                         for t in ("light", "dark") for f in ("", "fixo-caixa-lg", "flex-caixa-sm")]
+                casos = [(f"{n}-{i}" if "foco" in n else n, c) for i, (n, c) in enumerate(casos)]
+
+                def compara() -> dict:
+                    pares = [f"{nav.captura(f'antes-{n}.png', f'v=antes&{c}')},{nav.captura(f'atual-{n}.png', f'v=atual&{c}')}"
+                             for n, c in casos]
+                    return nav.le("diferenca.html?" + "&".join(f"par={p}" for p in pares), "DIFERENCA")
+
+                # A primeira captura de um perfil frio às vezes sai com um punhado de pixels de ruído, e
+                # o mesmo ref capturado duas vezes discorda neles. Só reprova a diferença que se repete.
+                dif = compara()
+                if any(dif.values()):
+                    dif = compara()
+                for par, n in dif.items():
+                    print(f"  {par.split(',')[1].removeprefix('atual-').removesuffix('.png'):<22} {n} pixels diferentes")
+                    if n:
+                        falhas.append(f"a vista fechada mudou: {par} com {n} pixels")
+        finally:
+            srv.shutdown()
+
+    if falhas:
+        print("\n✗ " + "\n✗ ".join(falhas))
+        return 1
+    print("✓ a caixa inteira é o controle" + (", e a vista fechada é a mesma" if contra else ""))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
