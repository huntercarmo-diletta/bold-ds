+// O SELETOR É A CAIXA INTEIRA, e a lista aberta tem a superfície da folha. Pedido do filho B em
+// 29/10: o recuo era da `.caixa`, o `<select>` tinha `padding: 0` e a seta era um `<span>`, então
+// só 27 a 32% da caixa abria a lista (medido pelo console no Edge). E o `background: none` deixava
+// a lista aberta do Chrome no Windows branca, com o texto claro do escuro.
+//
+// Isto é a CATRACA DE PAPEL: o jsdom não calcula layout nem abre lista, então aqui se prende o que
+// a peça escreve. A área de clique e a vista fechada se medem no navegador, em
+// `tool/o_seletor_e_a_caixa_inteira.py`; a lista aberta não entra em captura, e a conferência
+// dela no Chrome do Windows é manual, com o registro no veredito.
+import { test, before } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { JSDOM } from 'jsdom';
+
+before(async () => {
+  const dom = new JSDOM('<!doctype html><html><body></body></html>');
+  for (const k of ['window', 'document', 'customElements', 'HTMLElement', 'Node',
+                   'CustomEvent', 'Event', 'KeyboardEvent', 'DOMParser']) {
+    globalThis[k] = k === 'window' ? dom.window : dom.window[k];
+  }
+  await import('../src/diletta-dropdown.js');
+});
+
+const RECUO = { sm: 'var(--diletta-s1_5)', md: 'var(--diletta-s2)', lg: 'var(--diletta-s3)' };
+
+const monta = (attrs = {}) => {
+  const d = document.createElement('diletta-dropdown');
+  for (const [k, v] of Object.entries(attrs)) d.setAttribute(k, v);
+  d.innerHTML = '<option value="a">Curto</option><option value="b">Operador de atendimento</option>';
+  document.body.append(d);
+  return d;
+};
+
+// O corpo de uma regra, pelo seletor exato no começo da linha.
+const regra = (css, seletor) => {
+  const m = css.match(new RegExp(`(^|\\n)\\s*${seletor.replace(/[.[\]()"]/g, '\\$&')}\\s*\\{([^}]*)\\}`));
+  assert.ok(m, `a regra «${seletor}» sumiu da folha`);
+  return m[2];
+};
+
+for (const moldura of ['caixa', 'silencioso']) {
+  for (const porte of ['sm', 'md', 'lg']) {
+    test(`${moldura}/${porte}: o recuo é do select, e a seta deixa o clique passar`, () => {
+      const d = monta({ moldura, porte });
+      const css = d.shadowRoot.querySelector('style').textContent;
+      const caixa = regra(css, '.caixa');
+      const select = regra(css, 'select');
+      const seta = regra(css, '.seta');
+
+      // A caixa é só moldura: recuo nela é área que não abre a lista.
+      assert.doesNotMatch(caixa, /padding/, 'o recuo voltou para a caixa');
+      assert.match(caixa, /overflow: hidden/, 'sem o recorte, a quina fora da curva abre a lista');
+      assert.match(caixa, /position: relative/);
+
+      // O select estica até a borda e carrega o recuo; o fim reserva recuo + seta + vão, que é a
+      // mesma soma de antes, e é ela que mantém a largura intrínseca.
+      assert.match(select, /align-self: stretch/);
+      if (moldura === 'caixa') {
+        assert.match(select, new RegExp(`padding: var\\(--diletta-s2\\) ${RECUO[porte].replace(/[()]/g, '\\$&')};`));
+        assert.match(select, new RegExp(
+          `padding-inline-end: calc\\(${RECUO[porte].replace(/[()]/g, '\\$&')} \\+ 16px \\+ var\\(--diletta-s2\\)\\);`));
+      } else {
+        assert.match(select, /padding: 0;/);
+        assert.match(select, /padding-inline-end: calc\(16px \+ var\(--diletta-s2\)\);/);
+      }
+
+      // A seta fica sobre o recuo do fim, e o clique atravessa ela.
+      assert.match(seta, /pointer-events: none/, 'a seta voltou a engolir o clique');
+      assert.match(seta, /position: absolute/);
+      assert.match(seta, new RegExp(`inset-inline-end: ${moldura === 'caixa'
+        ? RECUO[porte].replace(/[()]/g, '\\$&') : '0'};`));
+      d.remove();
+    });
+  }
+
+  test(`${moldura}: a lista aberta é surface com fg, e só o marcador é textPlaceholder`, () => {
+    const d = monta({ moldura, placeholder: 'Escolha' });
+    const css = d.shadowRoot.querySelector('style').textContent;
+    // Declarado pela peça, e não herdado: com o marcador escolhido o select se pinta em
+    // textPlaceholder, e a cascata acinzentaria a lista inteira.
+    const opcao = regra(css, 'option, optgroup');
+    assert.match(opcao, /background-color: var\(--diletta-surface\)/);
+    assert.match(opcao, /color: var\(--diletta-fg\)/);
+    assert.match(regra(css, 'option[value=""]'), /color: var\(--diletta-textPlaceholder\)/);
+
+    // O fundo do select é o que o Chrome do Windows e do Linux dá ao painel. Na caixa é o surface
+    // dela, pintado só no conteúdo, para não repintar o antisserrilhado da borda nos cantos; no
+    // silencioso é transparente, e o gatilho fechado não ganha fundo próprio.
+    const select = regra(css, 'select');
+    assert.match(select, moldura === 'caixa'
+      ? /background-color: var\(--diletta-surface\);/ : /background-color: transparent;/);
+    assert.match(select, /background-clip: content-box/);
+    assert.doesNotMatch(select, /background: none/, 'o fundo voltou a ser «nenhum», e a lista sai branca');
+    d.remove();
+  });
+}
+
+test('o que já valia continua: desabilitado não abre, nome do rótulo, seta muda para o leitor', () => {
+  const d = monta({ label: 'Cargo', estado: 'desabilitado' });
+  const raiz = d.shadowRoot;
+  const sel = raiz.querySelector('select');
+  assert.equal(sel.disabled, true);
+  assert.match(regra(raiz.querySelector('style').textContent, 'select'), /cursor: default/);
+  assert.equal(raiz.querySelector('label').getAttribute('for'), sel.id);
+  assert.equal(raiz.querySelector('.seta').getAttribute('aria-hidden'), 'true');
+  // O anel continua sendo o outline da caixa, que o overflow não recorta.
+  assert.match(raiz.querySelector('style').textContent, /\.caixa:has\(:focus-visible\) \{\s*outline: 3px solid/);
+  d.remove();
+
+  const ligado = monta();
+  assert.match(regra(ligado.shadowRoot.querySelector('style').textContent, 'select'), /cursor: pointer/);
+  ligado.remove();
+});
+
+test('quem abre a lista é o clique no select nativo, e não um ouvinte com showPicker', () => {
+  // O clique no select traz cursor, foco e abertura de uma vez; o showPicker traz só a abertura,
+  // com suporte que varia entre navegadores. É o argumento que mantém a peça em volta do nativo.
+  const fonte = readFileSync(fileURLToPath(new URL('../src/diletta-dropdown.js', import.meta.url)), 'utf8');
+  assert.doesNotMatch(fonte.replace(/\/\/.*$|\/\*[\s\S]*?\*\//gm, ''), /showPicker/);
+});
