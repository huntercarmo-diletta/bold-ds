+/// O SELETOR ABRE PELA CAIXA INTEIRA — o lado Dart do pedido do filho B (29/10).
+///
+/// Na web, só o `<select>` abria a lista: o recuo era da caixa e a seta era um `<span>`, e 27 a 32%
+/// da caixa respondia. O filho leu o Dart e escreveu que aqui a área morta não existe, e pediu que o
+/// veredito confirmasse. A leitura estava certa: na `caixa` o `DilettaInput` envolve o contêiner
+/// inteiro num `DilettaTappable` opaco, com o campo `readOnly` em `IgnorePointer`; no `silencioso` o
+/// `DilettaTappable` opaco envolve valor e seta juntos.
+///
+/// Leitura de código não é contrato. Este arquivo é: o toque na seta, no recuo e no respiro abre a
+/// folha, e desabilitado não abre em ponto nenhum.
+library;
+
+import 'package:diletta_design_system/diletta_design_system.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+Future<void> monta(WidgetTester t, DilettaDropdownMoldura moldura, {bool disabled = false}) async {
+  await t.pumpWidget(DilettaThemeScope(
+    theme: DilettaTheme.resolve(palette: DilettaPalette.referencia),
+    child: MaterialApp(
+      home: Scaffold(
+        body: Center(
+          child: SizedBox(
+            width: 320,
+            child: Align(
+              alignment: Alignment.centerLeft,
+              child: DilettaDropdown(
+                label: 'Cargo',
+                items: const ['Analista', 'Operador de atendimento de segundo nível'],
+                value: 'Analista',
+                moldura: moldura,
+                disabled: disabled,
+                onChanged: (_) {},
+              ),
+            ),
+          ),
+        ),
+      ),
+    ),
+  ));
+  await t.pump();
+}
+
+Finder get seta => find.byWidgetPredicate(
+    (w) => w is DilettaIcon && w.name == DilettaIcons.chevronDownLight);
+
+Future<bool> abriuTocandoEm(WidgetTester t, Offset ponto) async {
+  await t.tapAt(ponto);
+  await t.pumpAndSettle();
+  final abriu = find.byType(BottomSheet).evaluate().isNotEmpty;
+  if (abriu) {
+    Navigator.of(t.element(find.byType(BottomSheet).first)).pop();
+    await t.pumpAndSettle();
+  }
+  return abriu;
+}
+
+void main() {
+  group('caixa', () {
+    // A caixa visível é o contêiner que o `DilettaInput` envolve no toque: o `DilettaTappable` dele.
+    Rect caixa(WidgetTester t) => t.getRect(find
+        .descendant(of: find.byType(DilettaInput), matching: find.byType(DilettaTappable))
+        .first);
+
+    testWidgets('a seta abre a folha', (t) async {
+      await monta(t, DilettaDropdownMoldura.caixa);
+      expect(await abriuTocandoEm(t, t.getCenter(seta)), isTrue,
+          reason: 'a seta é o desenho que diz «abre aqui»');
+    });
+
+    testWidgets('o recuo à esquerda do texto e acima dele abre a folha', (t) async {
+      await monta(t, DilettaDropdownMoldura.caixa);
+      final r = caixa(t);
+      expect(await abriuTocandoEm(t, Offset(r.left + 3, r.center.dy)), isTrue,
+          reason: 'o recuo à esquerda é área morta');
+      expect(await abriuTocandoEm(t, Offset(r.left + r.width / 3, r.top + 3)), isTrue,
+          reason: 'o recuo acima do texto é área morta');
+    });
+
+    testWidgets('desabilitado não abre em ponto nenhum', (t) async {
+      await monta(t, DilettaDropdownMoldura.caixa, disabled: true);
+      final r = caixa(t);
+      for (final p in [t.getCenter(seta), Offset(r.left + 3, r.center.dy), r.center]) {
+        expect(await abriuTocandoEm(t, p), isFalse, reason: 'abriu desabilitado em $p');
+      }
+    });
+  });
+
+  group('silencioso', () {
+    testWidgets('a seta e o respiro entre o valor e a seta abrem a folha', (t) async {
+      await monta(t, DilettaDropdownMoldura.silencioso);
+      expect(await abriuTocandoEm(t, t.getCenter(seta)), isTrue);
+      final valor = t.getRect(find.text('Analista'));
+      final glifo = t.getRect(seta);
+      expect(await abriuTocandoEm(t, Offset((valor.right + glifo.left) / 2, glifo.center.dy)), isTrue,
+          reason: 'o respiro entre o valor e a seta é área morta');
+    });
+
+    testWidgets('desabilitado não abre', (t) async {
+      await monta(t, DilettaDropdownMoldura.silencioso, disabled: true);
+      expect(await abriuTocandoEm(t, t.getCenter(seta)), isFalse);
+      expect(await abriuTocandoEm(t, t.getCenter(find.text('Analista'))), isFalse);
+    });
+  });
+}
